# Contoh pengaturan API. Salin menjadi .env (lokal) atau isi di Vercel > Settings > Environment Variables.
# Berkas ini sengaja tidak berisi rahasia sungguhan. Jangan commit .env, token, atau kata sandi.
#
# Tanpa pengaturan apa pun, API lokal membuat database SQLite sendiri di apps/api/.data/spekmate.db dan mengisinya
# dari data bawaan. Cukup untuk mencoba semuanya di komputer sendiri.

# --- Database ---------------------------------------------------------------------------------------------------
# Di produksi pakai Postgres (Neon, Supabase, Vercel Postgres, dan sebagainya). Bentuknya:
#   postgresql://PENGGUNA:KATA_SANDI@HOST:5432/NAMA_DB?sslmode=require
# Tanpa DATABASE_URL di Vercel, API berjalan read-only dari JSON bawaan dan menu admin menjawab 503.
# Diisi KOSONG (DATABASE_URL=) artinya sengaja tanpa database: situs tetap jalan dari JSON, admin mati.
# DATABASE_URL=

# --- Admin ------------------------------------------------------------------------------------------------------
# Lama sesi login admin, dalam jam (1 sampai 168). Bawaan 12.
# ADMIN_SESSION_HOURS=12
# Akun admin TIDAK dibuat lewat berkas ini dan tidak ada akun bawaan. Buat dengan:
#   python scripts/create_admin.py --email kamu@contoh.com

# --- Foto laptop ------------------------------------------------------------------------------------------------
# Produksi: token Vercel Blob (Storage > Blob > buat store *public*, lalu sambungkan ke project API).
# Vercel mengisi variabel ini sendiri saat store disambungkan. Jangan taruh nilainya di kode atau di web.
# BLOB_READ_WRITE_TOKEN=
# Lokal (tanpa token): foto disimpan di folder ini dan disajikan lewat /api/media. Jangan dipakai di Vercel,
# disk-nya tidak permanen.
# UPLOAD_DIR=/jalur/ke/folder/foto   (bawaan: apps/api/.data/uploads)
# Batas ukuran satu foto, dalam byte. Bawaan 4000000 (4 MB). Fungsi serverless Vercel membatasi isi permintaan
# sekitar 4,5 MB, jadi jangan dinaikkan melewati itu.
# MAX_UPLOAD_BYTES=4000000

# --- Lain-lain --------------------------------------------------------------------------------------------------
# Origin yang boleh memanggil API dari browser, dipisah koma. Web ini tidak memerlukannya.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Lama CDN menyimpan jawaban GET (detik). Dengan database aktif bawaannya 0 supaya perubahan admin langsung tampil.
# CACHE_SECONDS=300
